# ErenLabs environment configuration (set as Cloudflare Pages project
# environment variables / secrets - never commit real values).

# Comma-separated emails provisioned as administrators at register/login.
# Admin still requires a verified email and TOTP enrollment.
ADMIN_EMAILS=

# Outbound email provider for verification / reset mail.
# Supported: "resend". Without these, mail is stored in the admin-visible
# `outbox` table instead (development fallback, nothing is delivered).
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in (OIDC). Create an OAuth 2.0 client in Google Cloud Console
# with redirect URI https://erenlabs.me/api/auth/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone OTP via Twilio. Without these, phone sign-in stays disabled.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Password hash cost (optional). scrypt work factor, power of two,
# 16384-131072. Default 131072 (OWASP). Lower only if platform CPU
# enforcement tightens; takes effect on the next deployment.
SCRYPT_N=

# Bot check (Cloudflare Turnstile, free). When set, register / login / reset /
# comment / message endpoints require a valid widget token and fail closed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
